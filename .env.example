# Copy to .env beside compose.yaml. Provider secrets go only to the backend.
WEB_PORT=3000
# Local demo only. Changing this after DB creation also requires changing the DB role password.
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet_local_demo
CUSTODY_FRONTEND_ORIGIN=http://localhost:3000
# Set true only when serving the frontend through HTTPS.
CUSTODY_SECURE_COOKIE=false
# Optional OP Stack services: see appchain/README.md. No operator keys go here.
APPCHAIN_CHAIN_ID=42069
APPCHAIN_RPC_PORT=9545
APPCHAIN_NODE_PORT=9547
APPCHAIN_L1_RPC_URL=
# Optional separate execution RPC with a sufficient gas-simulation limit for deployment.
APPCHAIN_DEPLOYMENT_RPC_URL=
APPCHAIN_L1_BEACON_URL=
# Development memory caps, not minimum/recommended hardware requirements.
APPCHAIN_RETH_MEMORY=1536m
APPCHAIN_NODE_MEMORY=384m
APPCHAIN_BATCHER_MEMORY=256m
TRANSAK_ENVIRONMENT=staging
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_REFERRER_DOMAIN=http://localhost:3000
# Local single-developer staging: public IP of the browser opening checkout.
TRANSAK_SANDBOX_CLIENT_IP=
# Production only: explicitly trusted ingress/socket peer addresses.
TRANSAK_TRUSTED_PROXIES=

# Optional RPC overrides; defaults work without keys, subject to provider limits.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
BITCOIN_API_URL=https://mempool.space/api

# Preserved MoonPay channel (not the active purchase UI).
MOONPAY_ENVIRONMENT=sandbox
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_IP_MATCHING=true
MOONPAY_SANDBOX_CLIENT_IP=
MOONPAY_TRUSTED_PROXIES=
